<% if (theme.comment.livere.client_id) { %>
<!-- LiveRe 新版 Web Component (2025+) -->
<livere-comment client-id="<%= theme.comment.livere.client_id %>"></livere-comment>
<script type="module" src="https://www.livere.org/livere-widget.js"></script>
<% } else { %>
<!-- Livere 未配置: 在 _config.yml 的 comment.livere.client_id 填入来必力站点 client-id 后生效 -->
<% } %>