<!DOCTYPE html>
<html <% if (config.language) { %>lang="<%- config.language %>"<% } %>>
    <%- partial('_partial/head/index') %>

    <body class="<%= is_home() ? 'site-home' : 'site-inner' %>">
            <% if (theme.comment.use === 'facebook') { %>
                <% if ( (is_post()) ) { %>
                    <!-- Facebook SDK -->
                    <%- partial('_plugin/comment/facebook/common_head', {}, {cache: theme.fragment_cache}) %>
                <% } %>
            <% } %>

            <!-- ### Main content ### -->
            <%- partial('_partial/header', {}, {cache: theme.fragment_cache}) %>

            <!-- # PJAX 无刷新加载容器 (与 _config.yml 的 pjax.container 对应) # -->
            <div id="pjax-container">
                <%- body %>
            </div>

            <!-- ### Footer ### -->
            <%- partial('_partial/footer') %>

            <!-- ### 右侧工具栏 (含暗色模式切换; 置于 PJAX 容器外, 全站常驻) ### -->
            <%- partial('_partial/right', null, {cache: !config.relative_link}) %>

        <!-- ### Import File ### -->
        <%- partial('_partial/source/footer') %>


    </body>

</html>

<!-- # 这是线条动画 # -->
<script>
(function () {
    'use strict';

    var canvas = null;
    var context = null;
    var points = [];
    var cursor = { x: null, y: null, max: 20000 };
    var width = 0;
    var height = 0;
    var frame = 0;
    var running = false;
    var raf = window.requestAnimationFrame || function (callback) { return window.setTimeout(callback, 1000 / 45); };
    var caf = window.cancelAnimationFrame || window.clearTimeout;

    function storedEnabled(name) {
        try {
            return localStorage.getItem('suka-setting-' + name) !== '0';
        } catch (e) {
            return true;
        }
    }

    function resize() {
        if (!canvas) return;
        width = canvas.width = window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;
        height = canvas.height = window.innerHeight || document.documentElement.clientHeight || document.body.clientHeight;
    }

    function move(event) {
        cursor.x = event.clientX;
        cursor.y = event.clientY;
    }

    function leave() {
        cursor.x = null;
        cursor.y = null;
    }

    function draw() {
        if (!running || !context) return;
        context.clearRect(0, 0, width, height);
        for (var i = 0; i < points.length; i++) {
            var point = points[i];
            point.x += point.xa;
            point.y += point.ya;
            point.xa *= point.x > width || point.x < 0 ? -1 : 1;
            point.ya *= point.y > height || point.y < 0 ? -1 : 1;
            context.fillRect(point.x - .5, point.y - .5, 1, 1);
            for (var j = i + 1; j < points.length; j++) {
                var target = points[j];
                if (target.x === null || target.y === null) continue;
                var dx = point.x - target.x;
                var dy = point.y - target.y;
                var distance = dx * dx + dy * dy;
                if (distance >= target.max) continue;
                if (target === cursor && distance >= target.max / 2) {
                    point.x -= .03 * dx;
                    point.y -= .03 * dy;
                }
                var opacity = (target.max - distance) / target.max;
                context.beginPath();
                context.lineWidth = opacity / 2;
                context.strokeStyle = 'rgba(0,0,0,' + (opacity + .2) + ')';
                context.moveTo(point.x, point.y);
                context.lineTo(target.x, target.y);
                context.stroke();
            }
        }
        frame = raf(draw);
    }

    function start() {
        if (running) return;
        running = true;
        canvas = document.createElement('canvas');
        canvas.id = 'suka-particles';
        canvas.setAttribute('aria-hidden', 'true');
        canvas.style.cssText = 'position:fixed;top:0;left:0;z-index:-1;opacity:.5;pointer-events:none;';
        context = canvas.getContext('2d');
        document.body.appendChild(canvas);
        resize();
        points = [];
        for (var i = 0; i < 50; i++) {
            points.push({
                x: Math.random() * width,
                y: Math.random() * height,
                xa: 2 * Math.random() - 1,
                ya: 2 * Math.random() - 1,
                max: 6000
            });
        }
        points.push(cursor);
        window.addEventListener('resize', resize);
        window.addEventListener('mousemove', move);
        window.addEventListener('mouseout', leave);
        frame = raf(draw);
    }

    function stop() {
        running = false;
        if (frame) caf(frame);
        frame = 0;
        window.removeEventListener('resize', resize);
        window.removeEventListener('mousemove', move);
        window.removeEventListener('mouseout', leave);
        if (canvas && canvas.parentNode) canvas.parentNode.removeChild(canvas);
        canvas = null;
        context = null;
        points = [];
    }

    window.SukaParticles = {
        setEnabled: function (enabled) {
            try { localStorage.setItem('suka-setting-particles', enabled ? '1' : '0'); } catch (e) {}
            if (enabled) start(); else stop();
        },
        isEnabled: function () { return running; }
    };

    if (storedEnabled('particles')) start();
})();
</script>
<!-- # 这是天气 # -->
<div id="tp-weather-widget"></div>
<script>
(function () {
    'use strict';

    var weatherConfig = {
        flavor: 'bubble',
        location: 'WKND5EK53SYX',
        geolocation: true,
        language: 'zh-Hans',
        unit: 'c',
        theme: 'auto',
        token: 'c154a7e8-ec5d-49f8-b6a1-b1fb652e2534',
        hover: 'enabled',
        container: 'tp-weather-widget'
    };
    var loaded = false;

    function enabledByDefault() {
        try { return localStorage.getItem('suka-setting-weather') !== '0'; } catch (e) { return true; }
    }

    function show() {
        if (typeof window.SeniverseWeatherWidget === 'function') {
            window.SeniverseWeatherWidget('show', weatherConfig);
        }
    }

    function load() {
        if (loaded) { show(); return; }
        loaded = true;
        window.SeniverseWeatherWidgetObject = 'SeniverseWeatherWidget';
        window.SeniverseWeatherWidget = window.SeniverseWeatherWidget || function () {
            (window.SeniverseWeatherWidget.q = window.SeniverseWeatherWidget.q || []).push(arguments);
        };
        window.SeniverseWeatherWidget.l = +new Date();
        var script = document.createElement('script');
        script.src = '//cdn.sencdn.com/widget2/static/js/bundle.js?t=' + parseInt((new Date().getTime() / 100000000).toString(), 10);
        script.charset = 'utf-8';
        script.async = true;
        script.onload = show;
        document.head.appendChild(script);
    }

    window.SukaWeather = {
        setEnabled: function (enabled) {
            try { localStorage.setItem('suka-setting-weather', enabled ? '1' : '0'); } catch (e) {}
            document.documentElement.classList.toggle('suka-weather-disabled', !enabled);
            if (enabled) load();
        },
        isEnabled: function () { return !document.documentElement.classList.contains('suka-weather-disabled'); }
    };

    var enabled = enabledByDefault();
    document.documentElement.classList.toggle('suka-weather-disabled', !enabled);
    if (enabled) load();
})();
</script>


