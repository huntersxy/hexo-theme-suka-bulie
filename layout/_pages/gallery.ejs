<div class="container page-container">
    <div class="main-container page-main">
        <main class="page-card gallery-page">
            <div class="page-heading">
                <h1 class="page-title"><%= page.title || '画廊' %></h1>
                <p class="page-subtitle">收藏一些喜欢的瞬间</p>
            </div>
            <article class="gallery">
                <a class="gallery-link gallery-random-link" href="https://api.r10086.com/%E6%A8%B1%E9%81%93%E9%9A%8F%E6%9C%BA%E5%9B%BE%E7%89%87api%E6%8E%A5%E5%8F%A3.php?%E5%9B%BE%E7%89%87%E7%B3%BB%E5%88%97=%E5%B0%91%E5%A5%B3%E5%86%99%E7%9C%9F1" title="随机图片" data-descr="随机图片接口">
                    <figure class="gallery-image">
                        <img src="https://api.r10086.com/%E6%A8%B1%E9%81%93%E9%9A%8F%E6%9C%BA%E5%9B%BE%E7%89%87api%E6%8E%A5%E5%8F%A3.php?%E5%9B%BE%E7%89%87%E7%B3%BB%E5%88%97=%E5%B0%91%E5%A5%B3%E5%86%99%E7%9C%9F1" loading="lazy" decoding="async" alt="随机图片" referrerpolicy="no-referrer">
                        <figcaption>随机图片<br><small>随机图片接口</small></figcaption>
                    </figure>
                </a>
                <% if (site.data.gallery && Object.keys(site.data.gallery).length) { %>
                    <% for (var i in site.data.gallery) { %>
                        <a class="gallery-link" href="<%= site.data.gallery[i].full %>" title="<%= i %>" data-descr="<%= site.data.gallery[i].descr %>">
                            <figure class="gallery-image">
                                <img src="<%= site.data.gallery[i].thumb %>" loading="lazy" decoding="async" rel="<%= i %>" alt="<%= i %>">
                                <figcaption><%= i %><br><small><%= site.data.gallery[i].descr %></small></figcaption>
                            </figure>
                        </a>
                    <% } %>
                <% } else { %>
                    <p class="page-empty">画廊暂无内容：请在 <code>source/_data/gallery.yml</code> 中添加图片。</p>
                <% } %>
            </article>
        </main>
    </div>
</div>
<script src="<%- url_for('js/gallery.min.js') + '?v=' + theme.verison %>"></script>