<div class="container">
    <div class="main-container">
        <main>
            <div class="card tagscloud-card">
            <div class="tagscloud">
            <%- tagcloud({
                min_font: .85,
                max_font: 1.15,
                unit: 'rem',
                amount: 9999,
                color: true,
                start_color: '#8c95a4',
                end_color: '#3b4252',
                transform: 2,
            }) %>
            </div>
            </div>
        </main>
    </div>
</div>