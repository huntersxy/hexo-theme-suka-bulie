<div class="container page-container">
    <div class="main-container page-main">
        <main class="page-card tags-page">
            <div class="page-heading">
                <h1 class="page-title"><%= page.title || __('tag') %></h1>
                <p class="page-subtitle"><%= site.tags.length %> 个标签</p>
            </div>
            <div class="tagscloud">
                <%- tagcloud({
                    min_font: .85,
                    max_font: 1.1,
                    unit: 'rem',
                    amount: 9999,
                    color: true,
                    start_color: '#8c95a4',
                    end_color: '#3b4252',
                }) %>
            </div>
        </main>
    </div>
</div>